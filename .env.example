PORT=3000

# --- Database (SS-20). Either set a single connection string ...
# DATABASE_URL=mysql://user:pass@host:3306/department_db
# ... or the discrete variables below. A connection string wins when both are set.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=department_db
DB_USER=root
DB_PASSWORD=
# TLS to the database. Most managed hosts require it: use `require` (encrypt,
# don't verify the CA) or `strict` (verify). `false` disables. Auto-on when a
# connection string asks for it.
DB_SSL=
# Max pooled connections per process. Keep small on serverless so a fleet of
# instances doesn't exhaust the database's connection cap.
DB_POOL_LIMIT=4

GATEWAY_URL=http://127.0.0.1:4301
PUBLIC_URL=http://127.0.0.1:3000

# Secret used to HMAC-sign the app's own session cookie. Set a long random
# value in every real deployment (e.g. `openssl rand -hex 32`).
SESSION_SECRET=change-me-to-a-long-random-string
